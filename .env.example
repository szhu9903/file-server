# ===== 应用配置 =====
APP_TITLE=FastAPI Application
APP_VERSION=1.0.0

# 接口鉴权 Key，请求方需在请求头 X-API-KEY 中携带
API_KEY=your-api-key

# ===== Nextcloud WebDAV 配置 =====
# Nextcloud 服务地址
NEXTCLOUD_URL=https://your-nextcloud.example.com
NEXTCLOUD_USERNAME=your-username
NEXTCLOUD_PASSWORD=your-password
# 上传到 Nextcloud 的目标目录
UPLOAD_FOLDER=/tests/images/

# ===== MinIO 对象存储配置 =====
# 对外访问地址，用于生成文件下载链接
MINIO_URL=https://your-minio.example.com
# SDK 连接地址，格式 host:port
MINIO_ENDPOINT=your-minio.example.com:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=your-bucket
